{
  "expo": {
    "schema": "selfieBooks",
    "name": "selfieBooks",
    "slug": "selfieBooks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image/selfie_dark.jpg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/image/selfie_dark.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/image/selfie_dark.jpg",
        "backgroundColor": "#f2f2f2"
      }
    },
    "web": {
      "favicon": "./assets/image/selfie_dark.jpg"
    },
    "plugins": ["expo-router"]
  }
}
